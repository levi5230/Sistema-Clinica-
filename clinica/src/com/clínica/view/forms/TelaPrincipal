package com.clinica.view.forms;

import com.clinica.model.Usuario;
import com.clinica.util.TemaVisual;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.geom.RoundRectangle2D;

/**
 * VIEW — Menu principal com controlo de acesso por perfil.
 *
 * ADMIN        — acesso total
 * RECEPCIONISTA — Pacientes, Consultas, Relatórios
 * MEDICO       — Consultas, Prontuários
 */
public class TelaPrincipal extends JFrame {

    private Usuario usuarioLogado;

    public TelaPrincipal(Usuario usuario) {
        this.usuarioLogado = usuario;
        configurarJanela();
        construirComponentes();
    }

    private void configurarJanela() {
        setTitle("Sistema de Gestão de Clínica Médica");
        setSize(780, 560);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        getContentPane().setBackground(TemaVisual.CINZA_FUNDO);
    }

    private void construirComponentes() {
        setLayout(new BorderLayout(0, 0));

        // ---- Cabeçalho ----
        add(TemaVisual.criarCabecalho(
            "🏥  Sistema de Gestão de Clínica Médica",
            "Bem-vindo(a), " + usuarioLogado.getNome() + "  |  Perfil: " + usuarioLogado.getPerfil()
        ), BorderLayout.NORTH);

        // ---- Grid de botões ----
        JPanel painelGrid = new JPanel(new GridLayout(2, 3, 18, 18));
        painelGrid.setBackground(TemaVisual.CINZA_FUNDO);
        painelGrid.setBorder(new EmptyBorder(30, 35, 20, 35));

        String perfil = usuarioLogado.getPerfil();

        // Definição: nome, ícone, cor, permitido por perfil
        boolean isAdmin  = perfil.equals("ADMIN");
        boolean isRecep  = perfil.equals("RECEPCIONISTA");
        boolean isMedico = perfil.equals("MEDICO");

        // Permissões por módulo
        boolean podePacientes    = isAdmin || isRecep;
        boolean podeMedicos      = isAdmin;
        boolean podeConsultas    = isAdmin || isRecep || isMedico;
        boolean podeProntuarios  = isAdmin || isMedico;
        boolean podeRelatorios   = isAdmin || isRecep;

        JPanel cardPacientes   = criarCard("👤", "Pacientes",   "Gerir registos de pacientes",   new Color(46, 116, 181),  podePacientes);
        JPanel cardMedicos     = criarCard("🩺", "Médicos",     "Gerir corpo clínico",            new Color(39, 174, 96),   podeMedicos);
        JPanel cardConsultas   = criarCard("📅", "Consultas",   "Agendar e gerir consultas",      new Color(230, 126, 34),  podeConsultas);
        JPanel cardProntuarios = criarCard("📋", "Prontuários", "Registos médicos electrónicos",  new Color(142, 68, 173),  podeProntuarios);
        JPanel cardRelatorios  = criarCard("📊", "Relatórios",  "Relatórios gerenciais",          new Color(22, 160, 133),  podeRelatorios);
        JPanel cardSair        = criarCard("🚪", "Sair",        "Terminar sessão",                new Color(192, 57, 43),   true);

        painelGrid.add(cardPacientes);
        painelGrid.add(cardMedicos);
        painelGrid.add(cardConsultas);
        painelGrid.add(cardProntuarios);
        painelGrid.add(cardRelatorios);
        painelGrid.add(cardSair);

        // Acções — só adiciona listener se tiver permissão
        if (podePacientes)
            adicionarAcao(cardPacientes,   () -> new TelaPacientes(usuarioLogado).setVisible(true));
        if (podeMedicos)
            adicionarAcao(cardMedicos,     () -> new TelaMedicos(usuarioLogado).setVisible(true));
        if (podeConsultas)
            adicionarAcao(cardConsultas,   () -> new TelaConsultas(usuarioLogado).setVisible(true));
        if (podeProntuarios)
            adicionarAcao(cardProntuarios, () -> new TelaProntuarios(usuarioLogado).setVisible(true));
        if (podeRelatorios)
            adicionarAcao(cardRelatorios,  () -> new TelaRelatorios().setVisible(true));

        adicionarAcao(cardSair, () -> {
            int c = JOptionPane.showConfirmDialog(this, "Deseja terminar a sessão?", "Sair", JOptionPane.YES_NO_OPTION);
            if (c == JOptionPane.YES_OPTION) System.exit(0);
        });

        add(painelGrid, BorderLayout.CENTER);

        // Rodapé com info do perfil
        JLabel rodape = new JLabel(
            "Perfil: " + perfil + "  |  Universidade Kimpa Vita  |  Ling. Prog. VI  |  2026",
            SwingConstants.CENTER
        );
        rodape.setFont(new Font("Segoe UI", Font.PLAIN, 10));
        rodape.setForeground(TemaVisual.TEXTO_CINZA);
        rodape.setBorder(new EmptyBorder(0, 0, 10, 0));
        add(rodape, BorderLayout.SOUTH);
    }

    private JPanel criarCard(String icone, String titulo, String descricao, Color cor, boolean activo) {
        Color corFinal     = activo ? cor : new Color(180, 185, 195);
        Color corTexto     = activo ? TemaVisual.TEXTO_ESCURO : new Color(150, 155, 165);
        Color corDescricao = activo ? TemaVisual.TEXTO_CINZA  : new Color(180, 185, 195);
        String sufixo      = activo ? "" : "  🔒";

        JPanel card = new JPanel(new BorderLayout()) {
            boolean hover = false;

            @Override
            protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                if (activo && hover) {
                    g2.setColor(corFinal);
                } else {
                    g2.setColor(activo ? Color.WHITE : new Color(240, 241, 244));
                }
                g2.fill(new RoundRectangle2D.Float(0, 0, getWidth()-2, getHeight()-2, 14, 14));
                g2.setColor(corFinal);
                g2.fillRect(0, 3, getWidth()-2, 5);
                g2.fill(new RoundRectangle2D.Float(0, 0, getWidth()-2, 8, 4, 4));
                g2.dispose();
                super.paintComponent(g);
            }

            {
                if (activo) {
                    addMouseListener(new MouseAdapter() {
                        public void mouseEntered(MouseEvent e) {
                            hover = true; repaint();
                            atualizarCores(true);
                        }
                        public void mouseExited(MouseEvent e) {
                            hover = false; repaint();
                            atualizarCores(false);
                        }
                    });
                }
            }

            void atualizarCores(boolean h) {
                for (Component c : getComponents()) {
                    if (c instanceof JPanel) {
                        for (Component c2 : ((JPanel) c).getComponents()) {
                            if (c2 instanceof JLabel) {
                                JLabel lbl = (JLabel) c2;
                                if (lbl.getFont().getSize() >= 14)
                                    lbl.setForeground(h ? Color.WHITE : corTexto);
                                else
                                    lbl.setForeground(h ? new Color(220, 235, 255) : corDescricao);
                            }
                        }
                    }
                }
            }
        };

        card.setOpaque(false);
        card.setCursor(activo ? new Cursor(Cursor.HAND_CURSOR) : new Cursor(Cursor.DEFAULT_CURSOR));
        card.setBorder(new EmptyBorder(18, 18, 18, 18));

        // Ícone
        JLabel lblIcone = new JLabel(icone + (activo ? "" : " 🔒"), SwingConstants.CENTER);
        lblIcone.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 32));
        card.add(lblIcone, BorderLayout.NORTH);

        // Textos
        JPanel painelTexto = new JPanel(new GridLayout(2, 1, 0, 4));
        painelTexto.setOpaque(false);
        painelTexto.setBorder(new EmptyBorder(10, 0, 0, 0));

        JLabel lblTitulo = new JLabel(titulo, SwingConstants.CENTER);
        lblTitulo.setFont(new Font("Segoe UI", Font.BOLD, 14));
        lblTitulo.setForeground(corTexto);

        JLabel lblDesc = new JLabel(activo ? descricao : "Sem permissão de acesso", SwingConstants.CENTER);
        lblDesc.setFont(TemaVisual.FONTE_PEQUENA);
        lblDesc.setForeground(corDescricao);

        painelTexto.add(lblTitulo);
        painelTexto.add(lblDesc);
        card.add(painelTexto, BorderLayout.CENTER);

        return card;
    }

    private void adicionarAcao(Component card, Runnable acao) {
        card.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent e) { acao.run(); }
        });
    }
}
