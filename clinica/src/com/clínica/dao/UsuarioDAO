package com.clinica.dao;

import com.clinica.connection.ConexaoDB;
import com.clinica.model.Usuario;
import com.clinica.util.SenhaUtil;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

/**
 * DAO — concentra todo o código JDBC para a entidade Usuario.
 * Inclui método de autenticação (login).
 */
public class UsuarioDAO implements DAOGenerico<Usuario> {

    private Connection conn;

    public UsuarioDAO() {
        this.conn = ConexaoDB.getConexao();
    }

    /**
     * Autentica um utilizador pelo login e senha.
     * @return objeto Usuario se autenticado, null se falhar
     */
    public Usuario autenticar(String login, String senha) {
        String sql = "SELECT * FROM usuarios WHERE login = ? AND ativo = 1";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, login);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) {
                String hashArmazenado = rs.getString("senha");
                // Verifica o hash SHA-256
                if (SenhaUtil.verificar(senha, hashArmazenado)) {
                    return mapear(rs);
                }
            }
        } catch (SQLException e) {
            System.err.println("Erro na autenticação: " + e.getMessage());
        }
        return null; // login ou senha incorretos
    }

    @Override
    public void inserir(Usuario u) {
        String sql = "INSERT INTO usuarios (nome, login, senha, perfil, ativo) VALUES (?,?,?,?,?)";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, u.getNome());
            ps.setString(2, u.getLogin());
            ps.setString(3, SenhaUtil.hashSHA256(u.getSenha()));
            ps.setString(4, u.getPerfil());
            ps.setBoolean(5, true);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao inserir usuário: " + e.getMessage());
        }
    }

    @Override
    public void atualizar(Usuario u) {
        String sql = "UPDATE usuarios SET nome=?, login=?, perfil=? WHERE id=?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, u.getNome());
            ps.setString(2, u.getLogin());
            ps.setString(3, u.getPerfil());
            ps.setInt(4, u.getId());
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao atualizar usuário: " + e.getMessage());
        }
    }

    @Override
    public void deletar(int id) {
        String sql = "UPDATE usuarios SET ativo = 0 WHERE id = ?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, id);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao inativar usuário: " + e.getMessage());
        }
    }

    @Override
    public Usuario buscarPorId(int id) {
        String sql = "SELECT * FROM usuarios WHERE id = ?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, id);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return mapear(rs);
        } catch (SQLException e) {
            System.err.println("Erro ao buscar usuário: " + e.getMessage());
        }
        return null;
    }

    @Override
    public List<Usuario> listarTodos() {
        List<Usuario> lista = new ArrayList<>();
        String sql = "SELECT * FROM usuarios WHERE ativo = 1 ORDER BY nome";
        try (PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            while (rs.next()) lista.add(mapear(rs));
        } catch (SQLException e) {
            System.err.println("Erro ao listar usuários: " + e.getMessage());
        }
        return lista;
    }

    private Usuario mapear(ResultSet rs) throws SQLException {
        Usuario u = new Usuario();
        u.setId(rs.getInt("id"));
        u.setNome(rs.getString("nome"));
        u.setLogin(rs.getString("login"));
        u.setSenha(rs.getString("senha"));
        u.setPerfil(rs.getString("perfil"));
        u.setAtivo(rs.getBoolean("ativo"));
        return u;
    }
}
