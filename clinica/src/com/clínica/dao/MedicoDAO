package com.clinica.dao;

import com.clinica.connection.ConexaoDB;
import com.clinica.model.Medico;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class MedicoDAO implements DAOGenerico<Medico> {

    private Connection conn;

    public MedicoDAO() { this.conn = ConexaoDB.getConexao(); }

    @Override
    public void inserir(Medico m) {
        int espId = buscarOuCriarEspecialidade(m.getEspecialidade());
        String sql = "INSERT INTO medicos (especialidade_id, nome, crm, telefone, email, ativo) VALUES (?,?,?,?,?,1)";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, espId);
            ps.setString(2, m.getNome());
            ps.setString(3, m.getCrm());
            ps.setString(4, m.getTelefone());
            ps.setString(5, m.getEmail());
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao inserir médico: " + e.getMessage());
        }
    }

    @Override
    public void atualizar(Medico m) {
        int espId = buscarOuCriarEspecialidade(m.getEspecialidade());
        String sql = "UPDATE medicos SET especialidade_id=?, nome=?, crm=?, telefone=?, email=? WHERE id=?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, espId);
            ps.setString(2, m.getNome());
            ps.setString(3, m.getCrm());
            ps.setString(4, m.getTelefone());
            ps.setString(5, m.getEmail());
            ps.setInt(6, m.getId());
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao atualizar médico: " + e.getMessage());
        }
    }

    @Override
    public void deletar(int id) {
        try (PreparedStatement ps = conn.prepareStatement("UPDATE medicos SET ativo=0 WHERE id=?")) {
            ps.setInt(1, id); ps.executeUpdate();
        } catch (SQLException e) { System.err.println(e.getMessage()); }
    }

    @Override
    public Medico buscarPorId(int id) {
        String sql = "SELECT m.*, e.nome AS especialidade_nome FROM medicos m JOIN especialidades e ON m.especialidade_id=e.id WHERE m.id=?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, id);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return mapear(rs);
        } catch (SQLException e) { System.err.println(e.getMessage()); }
        return null;
    }

    @Override
    public List<Medico> listarTodos() {
        List<Medico> lista = new ArrayList<>();
        String sql = "SELECT m.*, e.nome AS especialidade_nome FROM medicos m JOIN especialidades e ON m.especialidade_id=e.id WHERE m.ativo=1 ORDER BY m.nome";
        try (PreparedStatement ps = conn.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {
            while (rs.next()) lista.add(mapear(rs));
        } catch (SQLException e) { System.err.println(e.getMessage()); }
        return lista;
    }

    public List<Medico> buscarPorNome(String nome) {
        List<Medico> lista = new ArrayList<>();
        String sql = "SELECT m.*, e.nome AS especialidade_nome FROM medicos m JOIN especialidades e ON m.especialidade_id=e.id WHERE m.ativo=1 AND m.nome LIKE ? ORDER BY m.nome";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, "%" + nome + "%");
            ResultSet rs = ps.executeQuery();
            while (rs.next()) lista.add(mapear(rs));
        } catch (SQLException e) { System.err.println(e.getMessage()); }
        return lista;
    }

    public List<String> listarEspecialidades() {
        List<String> lista = new ArrayList<>();
        try (PreparedStatement ps = conn.prepareStatement("SELECT nome FROM especialidades ORDER BY nome");
             ResultSet rs = ps.executeQuery()) {
            while (rs.next()) lista.add(rs.getString("nome"));
        } catch (SQLException e) { System.err.println(e.getMessage()); }
        return lista;
    }

    private int buscarOuCriarEspecialidade(String nome) {
        try (PreparedStatement ps = conn.prepareStatement("SELECT id FROM especialidades WHERE nome=?")) {
            ps.setString(1, nome);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return rs.getInt("id");
        } catch (SQLException e) { System.err.println(e.getMessage()); }
        try (PreparedStatement ps = conn.prepareStatement("INSERT INTO especialidades (nome) VALUES (?)", Statement.RETURN_GENERATED_KEYS)) {
            ps.setString(1, nome);
            ps.executeUpdate();
            ResultSet rs = ps.getGeneratedKeys();
            if (rs.next()) return rs.getInt(1);
        } catch (SQLException e) { System.err.println(e.getMessage()); }
        return 1;
    }

    private Medico mapear(ResultSet rs) throws SQLException {
        Medico m = new Medico();
        m.setId(rs.getInt("id"));
        m.setNome(rs.getString("nome"));
        m.setCrm(rs.getString("crm"));
        m.setEspecialidade(rs.getString("especialidade_nome"));
        m.setTelefone(rs.getString("telefone"));
        m.setEmail(rs.getString("email"));
        m.setAtivo(rs.getBoolean("ativo"));
        return m;
    }
}
