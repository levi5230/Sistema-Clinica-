package com.clinica.dao;

import com.clinica.connection.ConexaoDB;
import com.clinica.model.Medico;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

/**
 * DAO — concentra todo o código JDBC para a entidade Medico.
 */
public class MedicoDAO implements DAOGenerico<Medico> {

    private Connection conn;

    public MedicoDAO() {
        this.conn = ConexaoDB.getConexao();
    }

    @Override
    public void inserir(Medico m) {
        String sql = "INSERT INTO medicos (nome, crm, especialidade, telefone, email, ativo) VALUES (?,?,?,?,?,?)";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, m.getNome());
            ps.setString(2, m.getCrm());
            ps.setString(3, m.getEspecialidade());
            ps.setString(4, m.getTelefone());
            ps.setString(5, m.getEmail());
            ps.setBoolean(6, true);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao inserir médico: " + e.getMessage());
        }
    }

    @Override
    public void atualizar(Medico m) {
        String sql = "UPDATE medicos SET nome=?, crm=?, especialidade=?, telefone=?, email=? WHERE id=?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, m.getNome());
            ps.setString(2, m.getCrm());
            ps.setString(3, m.getEspecialidade());
            ps.setString(4, m.getTelefone());
            ps.setString(5, m.getEmail());
            ps.setInt(6, m.getId());
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao atualizar médico: " + e.getMessage());
        }
    }

    @Override
    public void deletar(int id) {
        String sql = "UPDATE medicos SET ativo = 0 WHERE id = ?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, id);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.err.println("Erro ao inativar médico: " + e.getMessage());
        }
    }

    @Override
    public Medico buscarPorId(int id) {
        String sql = "SELECT m.*, e.nome AS especialidade_nome FROM medicos m " +
                     "JOIN especialidades e ON m.especialidade_id = e.id WHERE m.id = ?";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, id);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return mapear(rs);
        } catch (SQLException e) {
            System.err.println("Erro ao buscar médico: " + e.getMessage());
        }
        return null;
    }

    @Override
    public List<Medico> listarTodos() {
        List<Medico> lista = new ArrayList<>();
        String sql = "SELECT m.*, e.nome AS especialidade_nome FROM medicos m " +
                     "JOIN especialidades e ON m.especialidade_id = e.id " +
                     "WHERE m.ativo = 1 ORDER BY m.nome";
        try (PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            while (rs.next()) lista.add(mapear(rs));
        } catch (SQLException e) {
            System.err.println("Erro ao listar médicos: " + e.getMessage());
        }
        return lista;
    }

    public List<Medico> buscarPorNome(String nome) {
        List<Medico> lista = new ArrayList<>();
        String sql = "SELECT m.*, e.nome AS especialidade_nome FROM medicos m " +
                     "JOIN especialidades e ON m.especialidade_id = e.id " +
                     "WHERE m.ativo = 1 AND m.nome LIKE ? ORDER BY m.nome";
        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, "%" + nome + "%");
            ResultSet rs = ps.executeQuery();
            while (rs.next()) lista.add(mapear(rs));
        } catch (SQLException e) {
            System.err.println("Erro ao buscar médico por nome: " + e.getMessage());
        }
        return lista;
    }

    private Medico mapear(ResultSet rs) throws SQLException {
        Medico m = new Medico();
        m.setId(rs.getInt("id"));
        m.setNome(rs.getString("nome"));
        m.setCrm(rs.getString("crm"));
        m.setEspecialidade(rs.getString("especialidade_nome"));
        m.setTelefone(rs.getString("telefone"));
        m.setEmail(rs.getString("email"));
        m.setAtivo(rs.getBoolean("ativo"));
        return m;
    }
}
