package com.clinica;

import com.clinica.util.TemaVisual;
import com.clinica.view.forms.TelaLogin;

import javax.swing.*;

/**
 * PONTO DE ENTRADA — arranca o sistema com tema visual
 */
public class Main {
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            TemaVisual.aplicar(); // Aplica o tema antes de qualquer janela
            new TelaLogin().setVisible(true);
        });
    }
}
