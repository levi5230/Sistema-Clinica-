package com.clinica.util;

import javax.swing.*;
import javax.swing.border.Border;
import javax.swing.border.EmptyBorder;
import javax.swing.plaf.basic.BasicScrollBarUI;
import javax.swing.table.DefaultTableCellRenderer;
import javax.swing.table.JTableHeader;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.geom.RoundRectangle2D;

/**
 * UTIL — Tema visual  para toda a aplicação.
 * Aplica cores, fontes e estilos consistentes.
 */
public class TemaVisual {

    // ============================================================
    // PALETA DE CORES
    // ============================================================
    public static final Color AZUL_PRIMARIO    = new Color(30, 100, 180);
    public static final Color AZUL_ESCURO      = new Color(13, 27, 62);
    public static final Color AZUL_HOVER       = new Color(20, 80, 150);
    public static final Color VERDE_SUCESSO    = new Color(39, 174, 96);
    public static final Color VERMELHO_ERRO    = new Color(192, 57, 43);
    public static final Color LARANJA_AVISO    = new Color(230, 126, 34);
    public static final Color CINZA_FUNDO      = new Color(245, 247, 252);
    public static final Color CINZA_CARD       = new Color(255, 255, 255);
    public static final Color CINZA_BORDA      = new Color(220, 225, 235);
    public static final Color TEXTO_ESCURO     = new Color(30, 40, 60);
    public static final Color TEXTO_CLARO      = new Color(255, 255, 255);
    public static final Color TEXTO_CINZA      = new Color(120, 130, 150);
    public static final Color TABELA_PAR       = new Color(249, 251, 255);
    public static final Color TABELA_IMPAR     = new Color(255, 255, 255);
    public static final Color TABELA_HEADER    = new Color(30, 100, 180);
    public static final Color TABELA_SELECAO   = new Color(200, 220, 255);

    // ============================================================
    // FONTES
    // ============================================================
    public static final Font FONTE_TITULO      = new Font("Segoe UI", Font.BOLD, 18);
    public static final Font FONTE_SUBTITULO   = new Font("Segoe UI", Font.BOLD, 14);
    public static final Font FONTE_NORMAL      = new Font("Segoe UI", Font.PLAIN, 13);
    public static final Font FONTE_PEQUENA     = new Font("Segoe UI", Font.PLAIN, 11);
    public static final Font FONTE_BOTAO       = new Font("Segoe UI", Font.BOLD, 13);
    public static final Font FONTE_LABEL       = new Font("Segoe UI", Font.PLAIN, 12);
    public static final Font FONTE_TABELA      = new Font("Segoe UI", Font.PLAIN, 12);
    public static final Font FONTE_HEADER      = new Font("Segoe UI", Font.BOLD, 12);

    // ============================================================
    // APLICAR TEMA GLOBAL
    // ============================================================
    public static void aplicar() {
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
        } catch (Exception e) {
            e.printStackTrace();
        }

        // Janelas
        UIManager.put("Panel.background",           CINZA_FUNDO);
        UIManager.put("OptionPane.background",      CINZA_FUNDO);
        UIManager.put("OptionPane.messageForeground", TEXTO_ESCURO);

        // Botões
        UIManager.put("Button.font",                FONTE_BOTAO);
        UIManager.put("Button.background",          AZUL_PRIMARIO);
        UIManager.put("Button.foreground",          TEXTO_CLARO);
        UIManager.put("Button.focusPainted",        false);

        // Labels
        UIManager.put("Label.font",                 FONTE_LABEL);
        UIManager.put("Label.foreground",           TEXTO_ESCURO);

        // Campos de texto
        UIManager.put("TextField.font",             FONTE_NORMAL);
        UIManager.put("TextField.foreground",       TEXTO_ESCURO);
        UIManager.put("TextField.caretForeground",  AZUL_PRIMARIO);
        UIManager.put("PasswordField.font",         FONTE_NORMAL);

        // Tabelas
        UIManager.put("Table.font",                 FONTE_TABELA);
        UIManager.put("Table.rowHeight",            Integer.valueOf(30));
        UIManager.put("Table.selectionBackground",  TABELA_SELECAO);
        UIManager.put("Table.selectionForeground",  TEXTO_ESCURO);
        UIManager.put("TableHeader.font",           FONTE_HEADER);
        UIManager.put("TableHeader.background",     TABELA_HEADER);
        UIManager.put("TableHeader.foreground",     TEXTO_CLARO);

        // ComboBox
        UIManager.put("ComboBox.font",              FONTE_NORMAL);

        // TextArea
        UIManager.put("TextArea.font",              FONTE_NORMAL);

        // TabbedPane
        UIManager.put("TabbedPane.font",            FONTE_SUBTITULO);
        UIManager.put("TabbedPane.selected",        AZUL_PRIMARIO);
    }

    // ============================================================
    // CRIAR BOTÃO ESTILIZADO
    // ============================================================
    public static JButton criarBotao(String texto, Color cor) {
        JButton btn = new JButton(texto) {
            @Override
            protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                if (getModel().isPressed()) {
                    g2.setColor(cor.darker());
                } else if (getModel().isRollover()) {
                    g2.setColor(cor.brighter());
                } else {
                    g2.setColor(cor);
                }
                g2.fill(new RoundRectangle2D.Float(0, 0, getWidth(), getHeight(), 10, 10));
                g2.dispose();
                super.paintComponent(g);
            }
        };
        btn.setFont(FONTE_BOTAO);
        btn.setForeground(TEXTO_CLARO);
        btn.setBackground(cor);
        btn.setBorderPainted(false);
        btn.setFocusPainted(false);
        btn.setOpaque(false);
        btn.setCursor(new Cursor(Cursor.HAND_CURSOR));
        btn.setBorder(new EmptyBorder(8, 18, 8, 18));
        return btn;
    }

    // ============================================================
    // CRIAR CAMPO DE TEXTO ESTILIZADO
    // ============================================================
    public static JTextField criarCampo(int colunas) {
        JTextField campo = new JTextField(colunas);
        campo.setFont(FONTE_NORMAL);
        campo.setForeground(TEXTO_ESCURO);
        campo.setBackground(Color.WHITE);
        campo.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(CINZA_BORDA, 1, true),
            new EmptyBorder(6, 10, 6, 10)
        ));
        campo.setCaretColor(AZUL_PRIMARIO);

        campo.addFocusListener(new java.awt.event.FocusAdapter() {
            public void focusGained(java.awt.event.FocusEvent e) {
                campo.setBorder(BorderFactory.createCompoundBorder(
                    BorderFactory.createLineBorder(AZUL_PRIMARIO, 2, true),
                    new EmptyBorder(5, 9, 5, 9)
                ));
            }
            public void focusLost(java.awt.event.FocusEvent e) {
                campo.setBorder(BorderFactory.createCompoundBorder(
                    BorderFactory.createLineBorder(CINZA_BORDA, 1, true),
                    new EmptyBorder(6, 10, 6, 10)
                ));
            }
        });
        return campo;
    }

    // ============================================================
    // CRIAR CAMPO DE SENHA ESTILIZADO
    // ============================================================
